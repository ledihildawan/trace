<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grid Architect V36 - Infinite Engine</title>
    <style>
      :root {
        --bg: #fdfeff;
        --grid-bg: #f1f5f9;
        --border: #e2e8f0;
        --cell-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --accent: #6366f1;
        --cyan: #06b6d4;
        --weekend-bg: #faf5ff;
        --weekend-text: #a855f7;
        --today-bg: #4f46e5;
        --month-start-bg: #f0fdfa;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
      }

      html,
      body {
        height: 100%;
        width: 100%;
        background: var(--bg);
        color: var(--text-main);
        font-family: 'Inter', system-ui, sans-serif;
        overflow: hidden;
      }

      /* Viewport tetap snap, tapi kita kelola isinya secara dinamis */
      #viewport {
        width: 100vw;
        height: 100vh;
        overflow-y: auto;
        scroll-snap-type: y mandatory;
        scrollbar-width: none;
        position: relative;
      }
      #viewport::-webkit-scrollbar {
        display: none;
      }

      /* Container besar untuk memberi ruang scroll "tak terbatas" */
      #infinite-canvas {
        position: relative;
        width: 100%;
        /* Tinggi diatur dinamis di JS */
      }

      .year-block {
        position: absolute;
        left: 0;
        width: 100vw;
        height: 100vh;
        scroll-snap-align: start;
        scroll-snap-stop: always;
        display: flex;
      }

      .grid-container {
        position: relative;
        flex: 1;
        display: flex;
        background: var(--bg);
      }

      .watermark-embedded {
        position: absolute;
        top: 0;
        right: 3%;
        height: 100%;
        display: flex;
        align-items: center;
        font-size: 28vh;
        font-weight: 950;
        color: transparent;
        -webkit-text-stroke: 1.5px var(--border);
        background: linear-gradient(to bottom, var(--border), var(--text-muted), var(--border));
        -webkit-background-clip: text;
        opacity: 0.25;
        writing-mode: vertical-rl;
        pointer-events: none;
        z-index: 5;
        letter-spacing: -1.5vh;
        white-space: nowrap;
      }

      .grid-layer {
        position: relative;
        z-index: 2;
        display: grid;
        gap: 1px;
        background: var(--grid-bg);
        width: 100%;
        height: 100%;
      }

      .cell {
        background: var(--cell-bg);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
      }

      .cell-content {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        pointer-events: none;
      }

      .cell .date-num {
        font-size: clamp(10px, 2vh, 18px);
        font-weight: 700;
        color: var(--text-main);
      }
      .cell .info-meta {
        font-size: clamp(6px, 0.9vh, 8px);
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 2px;
      }

      .cell.filler {
        background: var(--bg);
        opacity: 0.3;
      }
      .cell.weekend {
        background: var(--weekend-bg);
      }
      .cell.weekend .date-num,
      .cell.weekend .info-meta {
        color: var(--weekend-text);
      }
      .cell.month-start {
        background: var(--month-start-bg);
        box-shadow: inset 4px 0 0 var(--cyan);
      }
      .cell.month-start .date-num,
      .cell.month-start .info-meta {
        color: var(--cyan);
      }

      .cell.today {
        background: var(--today-bg) !important;
        z-index: 15;
        box-shadow: 0 0 20px rgba(79, 70, 229, 0.4);
      }
      .cell.today .date-num,
      .cell.today .info-meta {
        color: #fff !important;
        opacity: 1;
      }

      /* Navigasi Overlay (Opsional) */
      #year-indicator {
        position: fixed;
        bottom: 20px;
        left: 20px;
        padding: 10px 20px;
        background: rgba(15, 23, 42, 0.8);
        color: white;
        border-radius: 50px;
        font-weight: 700;
        z-index: 100;
        backdrop-filter: blur(10px);
        pointer-events: none;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div id="year-indicator">Memuat...</div>
    <main id="viewport">
      <div id="infinite-canvas"></div>
    </main>

    <script>
      const Viewport = document.getElementById('viewport');
      const Canvas = document.getElementById('infinite-canvas');
      const Indicator = document.getElementById('year-indicator');

      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];
      const daysLabel = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];

      const today = new Date();
      const startVirtualYear = today.getFullYear();

      // Konstanta Infinite
      const YEAR_HEIGHT = window.innerHeight;
      const TOTAL_VIRTUAL_YEARS = 20000; // 10,000 tahun ke belakang & ke depan
      const START_Y = (TOTAL_VIRTUAL_YEARS / 2) * YEAR_HEIGHT;

      let activeYears = new Map();

      function isLeap(y) {
        return (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
      }

      function createYearBlock(year, yPos) {
        if (activeYears.has(year)) return;

        const block = document.createElement('section');
        block.className = 'year-block';
        block.style.top = `${yPos}px`;

        const container = document.createElement('div');
        container.className = 'grid-container';

        const wm = document.createElement('div');
        wm.className = 'watermark-embedded';
        wm.innerText = year;
        container.appendChild(wm);

        const grid = document.createElement('div');
        grid.className = 'grid-layer';

        // Hitung kolom & baris (Statik per block agar tidak patah saat infinite)
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const cols = Math.ceil(Math.sqrt(365 * (vw / vh)));

        // Mencari offset hari pertama tahun tersebut terhadap hari Minggu (0)
        // Agar 1 Januari selalu di posisi hari yang benar
        const firstDayOfYear = new Date(year, 0, 1).getDay();
        const totalDays = isLeap(year) ? 366 : 365;
        const rows = Math.ceil((totalDays + firstDayOfYear) / cols);

        grid.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
        grid.style.gridTemplateRows = `repeat(${rows}, 1fr)`;

        for (let s = 0; s < cols * rows; s++) {
          const cell = document.createElement('div');
          cell.className = 'cell';

          const targetDate = new Date(year, 0, 1);
          targetDate.setDate(targetDate.getDate() + (s - firstDayOfYear));

          const d = targetDate.getDate();
          const mIdx = targetDate.getMonth();
          const cellYear = targetDate.getFullYear();
          const dayIdx = targetDate.getDay();

          if (cellYear !== year) {
            cell.classList.add('filler');
          } else {
            if (d === 1) cell.classList.add('month-start');
            if (dayIdx === 0 || dayIdx === 6) cell.classList.add('weekend');
            if (d === today.getDate() && mIdx === today.getMonth() && cellYear === today.getFullYear()) {
              cell.classList.add('today');
            }
          }

          cell.innerHTML = `
                    <div class="cell-content">
                        <span class="info-meta">${months[mIdx]} · ${daysLabel[dayIdx]}</span>
                        <span class="date-num">${d}</span>
                    </div>
                `;
          grid.appendChild(cell);
        }

        container.appendChild(grid);
        block.appendChild(container);
        Canvas.appendChild(block);
        activeYears.set(year, block);
      }

      function updateInfinite() {
        const scrollTop = Viewport.scrollTop;
        const currentIdx = Math.round(scrollTop / YEAR_HEIGHT);
        const currentYear = startVirtualYear + (currentIdx - TOTAL_VIRTUAL_YEARS / 2);

        Indicator.innerText = `Tahun ${currentYear}`;

        // Render jendela 3 tahun (tahun lalu, sekarang, tahun depan)
        for (let i = -1; i <= 1; i++) {
          const targetYear = currentYear + i;
          const targetYPos = (currentIdx + i) * YEAR_HEIGHT;
          createYearBlock(targetYear, targetYPos);
        }

        // Cleanup tahun yang jauh
        for (let [year, block] of activeYears) {
          if (Math.abs(year - currentYear) > 2) {
            block.remove();
            activeYears.delete(year);
          }
        }
      }

      // Inisialisasi
      Canvas.style.height = `${TOTAL_VIRTUAL_YEARS * YEAR_HEIGHT}px`;
      Viewport.scrollTop = START_Y; // Mulai di tengah (tahun sekarang)

      Viewport.addEventListener('scroll', updateInfinite);
      window.addEventListener('resize', () => location.reload()); // Refresh on resize for grid calc

      updateInfinite(); // Jalankan pertama kali
    </script>
  </body>
</html>
